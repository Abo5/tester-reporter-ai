# =============================================================================
# .env.example  —  copy this to .env and fill it in.
#
#   cp .env.example .env
#
# .env is gitignored and is NEVER read by the extension itself. It exists only
# so the live integration test can talk to the real Gemini API.
#
# The extension in the browser does NOT use this file. It reads its key from
# chrome.storage.local, set in the extension's own Settings page.
# =============================================================================

# Your key from Google AI Studio. Required for `npm run test:live`.
GEMINI_API_KEY=

# The model to test against.
#
# IMPORTANT: this project defaults to "gemini-3.5-flash", which could NOT be
# confirmed to exist. Put a model id you have verified here. If it is not in
# SUPPORTED_MODELS in src/shared/constants.ts, the live test will register it
# for the run and tell you to make the one-line change permanent.
GEMINI_MODEL=gemini-3.5-flash

# Report language for the live test: en or ar.
GEMINI_REPORT_LANGUAGE=en
