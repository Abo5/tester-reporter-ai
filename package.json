{
  "name": "tester-reporter-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Record a manual QA session and get a video, a runnable Playwright script, and an AI-written bug report.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-tests.mjs && node --test tests/*.test.mjs",
    "clean": "rm -rf dist dist-test",
    "verify": "npm run typecheck && npm run build && npm run test",
    "build:tests": "node scripts/build-tests.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3"
  }
}
